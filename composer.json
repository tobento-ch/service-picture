{
    "name": "tobento/service-picture",
    "version": "2.0",
    "type": "library",
    "description": "Picture support for PHP applications.",
    "keywords": [
        "tobento",
        "package",
        "PHP",
        "picture",
        "images"
    ],
    "homepage": "https://www.tobento.ch",
    "license": "MIT",
    "authors": [
        {
            "name": "Tobias Strub",
            "email": "info@tobento.ch",
            "homepage": "https://www.tobento.ch"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "tobento/service-imager": "^2.0",
        "tobento/service-dir": "^2.0",
        "tobento/service-filesystem": "^2.0",
        "tobento/service-tag": "^2.0",
        "psr/log": "^3.0",
        "league/mime-type-detection": "^1.16"
    },  
    "require-dev": {
        "phpunit/phpunit": "^12.3",
        "vimeo/psalm": "^6.13",
        "guzzlehttp/psr7": "^2.8",
        "monolog/monolog": "^3.9"
    },
    "autoload": {
        "psr-4": {
            "Tobento\\Service\\Picture\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tobento\\Service\\Picture\\Test\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit --testdox --colors=always",
        "psalm": "vendor/bin/psalm"
    }
}